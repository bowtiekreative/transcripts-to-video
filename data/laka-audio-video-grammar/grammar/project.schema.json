{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "LAVC Project",
  "type": "object",
  "required": [
    "project",
    "source",
    "output"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "seed": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "audio"
      ],
      "properties": {
        "audio": {
          "type": "string"
        },
        "transcript": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "enum": [
            "auto",
            "audio",
            "transcript",
            "directed"
          ]
        },
        "music": {
          "type": [
            "string",
            "null"
          ]
        },
        "overrides": {
          "type": [
            "string",
            "null"
          ]
        },
        "data": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "content": {
      "type": "object"
    },
    "brand": {
      "type": "object",
      "properties": {
        "preset": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "composition": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "studio",
            "wildcard"
          ]
        },
        "library": {
          "type": "string"
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "directory"
      ],
      "properties": {
        "directory": {
          "type": "string"
        },
        "aspect": {
          "enum": [
            "9:16",
            "16:9",
            "1:1",
            "4:5",
            "custom"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 240
        },
        "height": {
          "type": "integer",
          "minimum": 240
        },
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "captions": {
          "enum": [
            "none",
            "block",
            "karaoke",
            "lower_third"
          ]
        },
        "tail_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "rules": {
      "type": "object"
    }
  },
  "additionalProperties": true
}

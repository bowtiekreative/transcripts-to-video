(* LAVC formal authoring and compiled-scene grammar *)

program          = project_decl, source_decl, [brand_decl], output_decl,
                   {rule_decl | asset_decl | data_decl | override_decl};

project_decl     = "PROJECT", string, ["ID", identifier], ["SEED", value], ";";
source_decl      = "AUDIO", path, ["TRANSCRIPT", path],
                   ["MODE", ("audio" | "transcript" | "directed" | "auto")], ";";
brand_decl       = "BRAND", path, ";";
output_decl      = "OUTPUT", aspect, integer, "x", integer,
                   ["FPS", number], ["CAPTIONS", caption_mode], ";";

rule_decl        = "RULE", condition, "->", assignment, {logical_op, assignment}, ";";
condition        = predicate, {logical_op, predicate};
predicate        = field, comparator, value;
assignment       = field, "=", value;
logical_op       = "AND" | "OR";
comparator       = "=" | "!=" | ">" | ">=" | "<" | "<=" | "IN" | "MATCHES";

asset_decl       = "ASSET", identifier, path, ["ROLES", list],
                   ["FOCUS", number, ",", number], ";";
data_decl        = "DATA", identifier, path, ["ADAPTER", identifier], ";";
override_decl    = "OVERRIDE", selector, "{", {assignment, ";"}, "}";
selector         = "SCENE", identifier | "CUE", integer |
                   "TIME", number, "..", number | "TEXT", string;

scene            = "SCENE", identifier, time_range, "{",
                   meaning_block, visual_block, motion_block, quality_block, "}";
time_range       = number, "..", number;
meaning_block    = "MEANING", "{", "ACT", identifier, ";",
                   "RELATION", identifier, ";", [payload_block], "}";
payload_block    = "PAYLOAD", "{", {field, "=", value, ";"}, "}";
visual_block     = "VISUAL", "{", "INFOGRAPHIC", identifier, ";",
                   "LAYOUT", identifier, ";", "DENSITY", identifier, ";", "}";
motion_block     = "MOTION", "{", "FAMILY", identifier, ";",
                   {laka_meta, "=", value, ";"}, "}";
quality_block    = "QUALITY", "{", {field, "=", value, ";"}, "}";

laka_meta        = "magnitude" | "rate" | "direction" | "scope" | "depth" |
                   "duration" | "frequency" | "acceleration" | "variability" |
                   "detectability" | "reversibility" | "propagation" |
                   "amplification" | "accumulation";

caption_mode     = "none" | "block" | "karaoke" | "lower_third";
aspect           = "9:16" | "16:9" | "1:1" | "4:5" | "custom";
field            = identifier, {".", identifier};
list             = "[", [value, {",", value}], "]";
value            = string | number | integer | identifier | list | boolean;
boolean          = "true" | "false";
identifier       = letter, {letter | digit | "_" | "-"};
path             = string;
string           = '"', {character - '"'}, '"';
number           = ["-"], digit, {digit}, [".", digit, {digit}];
integer          = ["-"], digit, {digit};
letter           = "A".."Z" | "a".."z";
digit            = "0".."9";
